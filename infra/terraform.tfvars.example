# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.

# Hetzner Cloud API token
# console.hetzner.cloud → your project → Security → API Tokens → Generate (Read & Write)
hcloud_token = "your-hetzner-api-token-here"

# Datacenter location — "ash" (Ashburn, US) keeps latency low if you're in the US
location    = "ash"
server_type = "cpx11"   # Intel, 2 GB RAM — available in all locations

# Your personal SSH public key — run: cat ~/.ssh/id_ed25519.pub
admin_ssh_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... your@email.com"

# Cloudflare — for R2 backup bucket
# Account ID: dash.cloudflare.com → any domain → right sidebar, or Workers & Pages overview
# API token:  dash.cloudflare.com → My Profile → API Tokens → Create Token
#             Use template "R2 Token" or add permission: Account > Cloudflare R2 Storage > Edit
cloudflare_account_id = "your-cloudflare-account-id-here"
cloudflare_api_token  = "your-cloudflare-api-token-here"
